FROM node:22-alpine AS build
WORKDIR /web
ARG VITE_API_BASE_URL=/api
ARG VITE_APP_SURFACE=public
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_APP_SURFACE=${VITE_APP_SURFACE}
COPY package.json package-lock.json /web/
RUN npm ci --ignore-scripts
COPY . /web
RUN npm run build && find /web/dist -type f -name '*.map' -delete

FROM nginx:1.27-alpine
COPY nginx.public.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
